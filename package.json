{
  "name": "uttgo",
  "version": "1.0.0",
  "engines": { "node": ">=22.13.0" },
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.25",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "~30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.0",
    "jest-expo": "~58.0.0",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --coverage",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testPathPatterns=integration --passWithNoTests",
    "test:watch": "jest --watch",
    "test:ci": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --ci --runInBand --coverage",
    "doctor": "npx expo-doctor"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": { "^.+\\.[jt]sx?$": ["babel-jest", { "presets": ["babel-preset-expo"] }] },
    "moduleNameMapper": { "^@/(.*)$": "<rootDir>/src/$1" },
    "transformIgnorePatterns": ["node_modules/(?!(react-native|@expo|@react-native|expo)/)"],
    "preset": "jest-expo",
    "maxWorkers": 2,
    "setupFilesAfterEnv": ["@testing-library/jest-native/extend-expect"],
    "moduleFileExtensions": ["ts", "tsx", "js", "jsx", "json"],
    "testMatch": ["**/__tests__/**/*.[jt]s?(x)", "**/?(*.)+(spec|test).[jt]s?(x)"],
    "collectCoverageFrom": ["src/**/*.{ts,tsx}", "!src/**/*.d.ts", "!src/app/**", "!src/components/**", "!src/context/**", "!src/data/**", "!src/theme/**", "!src/hooks/**", "!src/navigation/**", "!src/types/models.ts", "!src/services/mockApi.ts"],
    "coverageThreshold": { "global": { "branches": 70, "functions": 80, "lines": 80, "statements": 80 } }
  },
  "private": true
}
