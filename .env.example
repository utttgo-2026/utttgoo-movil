# Copiar a .env; origen HTTPS confirmado (sin /api/v1).
# HTTP permite únicamente GET /health. Para autenticación es obligatorio HTTPS.
# EXPO_PUBLIC_* es configuración pública; nunca incluir tokens o contraseñas.
EXPO_PUBLIC_API_BASE_URL=https://3.129.142.54.nip.io

# Experimento temporal: true solo en desarrollo o build interna beta-registration.
# Producción debe conservar false; no modifica verificación ni autorización del backend.
EXPO_PUBLIC_BETA_REGISTRATION_ONLY=false

# Mismo proyecto Supabase que usa AWS. Completar solo con valores públicos reales.
# Nunca service_role, sb_secret_ ni credenciales SMTP.
EXPO_PUBLIC_SUPABASE_URL=https://tabhbylbhewtehvirexn.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
