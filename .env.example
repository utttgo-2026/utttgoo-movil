# Copiar a .env; origen HTTPS confirmado (sin /api/v1).
# HTTP permite únicamente GET /health. Para autenticación es obligatorio HTTPS.
# EXPO_PUBLIC_* es configuración pública; nunca incluir tokens o contraseñas.
# Guía de clonación y Expo Go: docs/COLABORACION.md
EXPO_PUBLIC_API_BASE_URL=https://3.129.142.54.nip.io

# Experimento temporal: true solo en desarrollo o build interna beta-registration.
# Producción debe conservar false; no modifica verificación ni autorización del backend.
EXPO_PUBLIC_BETA_REGISTRATION_ONLY=false
EXPO_PUBLIC_CATALOG_SOURCE=aws

# Opcional: pr33 solo para demostración local aislada en Expo Go (__DEV__). Vacío por defecto.
# No habilita Media real; no cambia permisos ni publica datos AWS. Ver docs/MEDIA_PR33_EXPO_GO.md.
EXPO_PUBLIC_MEDIA_DEMO=

# Prueba manual REAL con cuenta Seller autorizada, únicamente Expo Go (__DEV__).
# Vacío por defecto; controlled habilita transferencias reales al backend verificado.
# Nunca usar junto con MEDIA_DEMO=pr33. No activa builds de producción.
EXPO_PUBLIC_MEDIA_REAL=

# Mismo proyecto Supabase que usa AWS. Completar solo con valores públicos reales.
# Nunca service_role, sb_secret_ ni credenciales SMTP.
# Completar la publishable pública del proyecto del equipo, solicitada al responsable.
# El ejemplo queda sin clave deliberadamente. No copiar .env a Git ni compartir sesiones de usuario.
EXPO_PUBLIC_SUPABASE_URL=https://tabhbylbhewtehvirexn.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
